# 构建阶段
FROM node:20-alpine AS builder

WORKDIR /app

# better-sqlite3 为原生模块，安装构建工具以备无预编译二进制时从源码编译
RUN apk add --no-cache python3 make g++

# 复制 package 文件
COPY package.json package-lock.json ./

# 安装生产依赖
RUN npm ci --only=production

# 复制源代码
COPY src/ ./src/

# 运行时阶段
FROM node:20-alpine

WORKDIR /app

# 从构建阶段复制依赖
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/src ./src

# 复制前端构建文件（在构建时由脚本复制）
COPY public/ ./public/

# 创建必要的目录：
# /app/data        —— SQLite 数据库文件及备份数据（通过 volume 持久化）
# /tmp/uploads     —— 文件上传临时目录
RUN mkdir -p /tmp/uploads /app/data /app/data/backups && \
    chown -R node:node /app/data /tmp/uploads

# 容器元数据
LABEL maintainer="gift-ledger"
LABEL description="人情记账系统"
LABEL org.opencontainers.image.title="Gift Ledger"
LABEL org.opencontainers.image.description="人情记账系统 - 记录人情往来"
LABEL org.opencontainers.image.version="1.0.0"
LABEL org.opencontainers.image.source="https://github.com/situ254/gift-ledger"

# 环境变量配置
ENV PORT=9205
# SQLite 数据库文件路径（挂载 volume 持久化）
ENV DB_PATH=/app/data/gift_ledger.db
# 备份数据目录（与数据库统一持久化到 /app/data 卷下）
ENV CLOUD_DATA_DIR=/app/data/backups
ENV JWT_SECRET=gift_ledger_secret_key_2024
ENV NODE_ENV=production
ENV LOG_LEVEL=info
# 自动备份定时（cron: 分 时 日 月 星期），默认每月1号、16号 22:00（晚上10点）
ENV AUTO_BACKUP_SCHEDULE="0 22 1,16 * *"

# 管理员账号环境变量（与 index.js 中读取的变量名一致，可被覆盖）
ENV ADMIN_USERNAME=admin
ENV ADMIN_PASSWORD=admin123

# 声明数据持久化卷（数据库 + 备份文件均在此目录下）
VOLUME ["/app/data"]

# 健康检查
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:9205/api/health || exit 1

EXPOSE 9205

# 非root用户运行（安全增强）
USER node

CMD ["node", "src/index.js"]
